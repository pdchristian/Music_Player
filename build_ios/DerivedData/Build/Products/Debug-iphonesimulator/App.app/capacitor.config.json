{
	"appId": "com.beatclip.app",
	"appName": "BeatClip",
	"webDir": "app",
	"server": {
		"androidScheme": "https",
		"allowNavigation": []
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 900,
			"launchAutoHide": true,
			"backgroundColor": "#0f1115",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP",
			"ios": {
				"launchEditMode": "adaptive"
			}
		}
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"packageClassList": [
		"BeatClipMediaPlugin"
	]
}
